# Copy to .env (git-ignored) or set these in the environment.

# Required. Request-signing key for tensor.art, also used for tensorhub.art
# unless TENSORHUB_SIGN_KEY is set.
TENSORART_SIGN_KEY=
# Optional. Separate signing key for tensorhub.art.
TENSORHUB_SIGN_KEY=

# Optional
# DEFAULT_SOURCE=all          # tensorart, tensorhub or all
# CACHE_TTL=300
# UPSTREAM_CONCURRENCY=8
# MAX_UPSTREAM_PAGES=5
# HOST=0.0.0.0
# PORT=8000

# Optional: act as your own account (private uploads). The site's login token
# (the ta_token_prod cookie); it renews itself daily and the newest copy is kept in STATE_DIR.
# TENSORART_SESSION=
# STATE_DIR=./state
# API_TOKEN=                  # required bearer for the account endpoints when set
# ACCOUNT_SOURCE=tensorhub
