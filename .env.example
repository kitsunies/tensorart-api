# Copy to .env (git-ignored) or set these in the environment.

# Required. Request-signing key for tensor.art, also used for tensorhub.art
# unless TENSORHUB_SIGN_KEY is set.
TENSORART_SIGN_KEY=
# Optional. Separate signing key for tensorhub.art.
TENSORHUB_SIGN_KEY=

# Optional
# DEFAULT_SOURCE=all          # tensorart, tensorhub or all
# CACHE_TTL=300
# UPSTREAM_CONCURRENCY=8
# MAX_UPSTREAM_PAGES=5
# HOST=0.0.0.0
# PORT=8000
